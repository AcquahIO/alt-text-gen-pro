<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_URI} ^/?$
  RewriteCond %{HTTP:Cookie} (^|;\s*)lang_pref=en-US(;|$) [NC]
  RewriteRule ^$ /en-US/ [R=302,L]

  RewriteCond %{REQUEST_URI} ^/?$
  RewriteCond %{HTTP:Cookie} (^|;\s*)lang_pref=en-GB(;|$) [NC]
  RewriteRule ^$ /en-GB/ [R=302,L]

  RewriteCond %{REQUEST_URI} ^/?$
  RewriteCond %{HTTP:Accept-Language} (^|,)\s*en-US [NC]
  RewriteRule ^$ /en-US/ [R=302,L]

  RewriteCond %{REQUEST_URI} ^/?$
  RewriteRule ^$ /en-GB/ [R=302,L]

  RewriteCond %{REQUEST_URI} ^/(?:api|mcp)/?$ [NC]
  RewriteCond %{HTTP:Cookie} (^|;\s*)lang_pref=en-US(;|$) [NC]
  RewriteRule ^(?:api|mcp)/?$ /en-US/api/ [R=302,L]

  RewriteCond %{REQUEST_URI} ^/(?:api|mcp)/?$ [NC]
  RewriteRule ^(?:api|mcp)/?$ /en-GB/api/ [R=302,L]

  RewriteRule ^(en-GB|en-US)/api$ /$1/api/ [R=308,L,NE]
  RewriteRule ^(en-GB|en-US)/mcp/?$ /$1/api/ [R=308,L,NE]
  RewriteRule ^(en-GB|en-US)/app(?:/.*)?$ /$1/ [R=308,L,NE]
  RewriteRule ^(privacy|terms)$ /$1/ [R=308,L,NE]

  # Do not expose the Vite app shell as a second, metadata-poor homepage.
  RewriteRule ^index\.html$ /en-GB/ [R=308,L,NE]

  # Hashed build assets must never fall through to the HTML app shell. Returning
  # a real 404 makes stale cached pages fail visibly instead of serving HTML with
  # a JavaScript or stylesheet URL (which browsers reject as a MIME mismatch).
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Marketing routes are emitted as real files/directories. Unknown routes must
  # remain real 404s instead of inheriting the home-page shell and index signals.
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # The HTML shell points at content-hashed assets, so it must be revalidated
  # after every deploy. The hashed assets themselves are safe to cache long-term.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://alt-text-gen-pro-backend-4e3b4315d0d7.herokuapp.com; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests"
</IfModule>
