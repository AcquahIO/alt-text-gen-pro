{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "0.2.0",
  "description": "__MSG_ext_desc__",
  "default_locale": "en",
  "permissions": ["activeTab", "contextMenus", "storage", "identity", "scripting"],
  "host_permissions": ["https://alt-text-gen-pro-backend-4e3b4315d0d7.herokuapp.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_ext_name__",
    "default_popup": "ui-dist/popup.html",
    "default_icon": {
      "16": "icons/action-icon-16.png",
      "32": "icons/action-icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-128.png",
        "icons/icon-32.png",
        "icons/icon-16.png",
        "icons/action-icon-32.png",
        "icons/action-icon-16.png",
        "icons/ui-copy.svg",
        "icons/ui-refresh-cw.svg",
        "icons/ui-x.svg"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
